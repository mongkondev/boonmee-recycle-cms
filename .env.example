# Postgres connection (local docker: `docker compose up -d`)
DATABASE_URL=postgres://boonmee:boonmee@localhost:54330/boonmee_cms
# Random 32+ char string: `openssl rand -base64 32`
SESSION_SECRET=change-me-to-a-long-random-string
# Super admin created by `npm run db:seed` (change password after first login)
SUPER_ADMIN_EMAIL=mongkon.dev@gmail.com
ADMIN_PASSWORD=Admin@1234
# Optional: send invitation e-mails through Resend (https://resend.com, free tier).
# Without these the invite link is shown for copy / LINE share instead.
RESEND_API_KEY=
MAIL_FROM="Boonmee Recycle <noreply@your-domain.com>"
